# URL pública del frontend, usada en los enlaces de verificación y despachos.
SITE_URL=http://localhost:5173

# Correo local con Mailpit (Supabase)
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_FROM=Segunda Compania <no-reply@demo.local>

# En producción usa SMTP real o Resend:
# SMTP_HOST=smtp.tuproveedor.cl
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=Segunda Compania <no-reply@tu-dominio.cl>
# RESEND_API_KEY=re_...

# Meta WhatsApp Cloud API (mensajes 1-a-1 con plantillas aprobadas)
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_LANG=es_CL
WHATSAPP_TEMPLATE_COMUNICADO=comunicado_compania
WHATSAPP_TEMPLATE_CITACION=citacion_compania
WHATSAPP_TEMPLATE_GUARDIA=guardia_aviso
WHATSAPP_TEMPLATE_LLEGADA_TARDIA=guardia_llegada_tardia

# Token interno para cron (pg_net, Cloudflare Cron o GitHub Actions)
# CRON_SECRET=...
