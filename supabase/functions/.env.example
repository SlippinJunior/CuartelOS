# URL pública del frontend, usada en los enlaces de verificación.
SITE_URL=http://localhost:5173

# Correo local con Mailpit (Supabase)
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_FROM=Segunda Compania <no-reply@demo.local>

# En producción usa SMTP real o Resend:
# SMTP_HOST=smtp.tuproveedor.cl
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=Segunda Compania <no-reply@tu-dominio.cl>
# RESEND_API_KEY=re_...

# WhatsApp Cloud API (opcional). Sin credenciales se usan enlaces wa.me.
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=1234567890

# Token interno para el cron de avisos de guardia (opcional).
# CRON_SECRET=una-cadena-larga-aleatoria
