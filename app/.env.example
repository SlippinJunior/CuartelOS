# URL local de Supabase (la imprime `pnpm supabase status`).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Usa la clave ANON_KEY (JWT que empieza con eyJ...), NO la PUBLISHABLE_KEY.
# La publishable key no sirve para las llamadas anónimas de PostgREST en esta
# versión del CLI: la verificación pública y otras RPC sin sesión fallarían.
# Cópiala de la salida de `pnpm supabase status` ("anon key").
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
